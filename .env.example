# Postgres connection string
DATABASE_URL="postgresql://pavilion:pavilion@localhost:5432/pavilion_services"

# Public base URL used in emails and Stripe redirects
APP_URL="http://localhost:3000"

# Admin login (Pavilion staff). Use a long random password in any shared environment.
ADMIN_PASSWORD="change-me"
# Random 32+ char string used to sign the admin session cookie
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Where "address review requested" alerts go
ADMIN_EMAIL="you@example.com"

# Stripe (test mode). Leave STRIPE_SECRET_KEY empty to use the built-in mock
# checkout, which lets you click through the whole flow with no Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend. Leave empty to log emails to the admin Outbox instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="Pavilion <onboarding@resend.dev>"

# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token)
CRON_SECRET="replace-me"
